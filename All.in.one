:root {
    --black: #050505;
    --white: #ffffff;
    --accent: #6366f1; /* Modern Indigo */
    --gray: #86868b;
    --glass: rgba(255, 255, 255, 0.7);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
body { 
    font-family: 'Outfit', sans-serif; 
    background-color: var(--white); 
    color: var(--black);
    overflow-x: hidden;
}

/* Glassmorphism Nav */
.glass-nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1200px;
    background: var(--glass);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 15px 40px;
    border-radius: 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
}

.logo { font-weight: 700; font-size: 1.2rem; letter-spacing: 2px; }

/* Hero Section */
.hero-v2 {
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 10%;
    background: radial-gradient(circle at top right, #f0f0faff, #ffffff);
}

.hero-text h1 { font-size: 5rem; line-height: 1.1; margin-bottom: 20px; }
.gradient-text { 
    background: linear-gradient(90deg, var(--accent), #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.badge {
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 2px;
}

/* Buttons */
.btn-dark {
    padding: 16px 35px;
    background: var(--black);
    color: white;
    border: none;
    border-radius: 30px;
    font-weight: 500;
    cursor: pointer;
    transition: 0.3s;
}

.btn-dark:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }

/* Product Section */
.shop-container { padding: 100px 10%; }

.product-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.image-reveal img {
    width: 100%;
    border-radius: 30px;
    transition: transform 0.5s ease;
}

.image-reveal:hover img { transform: scale(1.02); }

.spec-list {
    margin: 30px 0;
    border-top: 1px solid #eee;
}

.spec {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
    color: var(--gray);
}

.price-tag { font-size: 2rem; font-weight: 700; }

.buy-now {
    padding: 15px 40px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    cursor: pointer;
}

/* Responsive */
@media (max-width: 768px) {
    .product-wrapper { grid-template-columns: 1fr; }
    .hero-text h1 { font-size: 3rem; }
}
